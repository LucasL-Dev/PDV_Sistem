{
  "name": "omnipdv",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.mjs",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "pnpm --filter @fiscal/agente... --filter @fiscal/ui... build && vite build",
    "start": "electron .",
    "test": "node --test tests/*.test.mjs",
    "dist": "pnpm build && electron-builder --config electron-builder.config.cjs",
    "smoke": "electron --ozone-platform=headless --disable-gpu .",
    "dist:win": "pnpm build && electron-builder --config electron-builder.config.cjs --win nsis --x64 --publish never"
  },
  "dependencies": {
    "@fiscal/agente": "workspace:*",
    "@fiscal/ui": "workspace:*",
    "exceljs": "4.4.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "electron": "45.0.0",
    "electron-builder": "26.15.3",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vite": "6.4.1"
  },
  "build": {
    "appId": "br.com.pdvsistem",
    "productName": "OmniPDV",
    "files": [
      "dist/**",
      "electron/**",
      "package.json",
      "assets/brand/**"
    ],
    "asarUnpack": [
      "**/node_modules/@electric-sql/pglite/**",
      "**/node_modules/pdfkit/**"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "OmniPDV-Setup-${version}-${arch}.${ext}",
      "signExecutable": false,
      "icon": "assets/brand/omnipdv.ico"
    },
    "linux": {
      "target": "AppImage"
    },
    "directories": {
      "output": "release"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "assets/brand/omnipdv.ico",
      "uninstallerIcon": "assets/brand/omnipdv.ico",
      "shortcutName": "OmniPDV",
      "uninstallDisplayName": "OmniPDV"
    },
    "icon": "assets/brand/icon-512.png"
  },
  "description": "OmniPDV — ponto de venda com caixa, estoque e NFC-e",
  "author": "LucasL-Dev",
  "engines": {
    "node": ">=24"
  },
  "productName": "OmniPDV"
}
